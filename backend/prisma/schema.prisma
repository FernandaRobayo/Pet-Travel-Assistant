generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Usuario {
  id           String @id @default(uuid()) @db.Uuid
  correo       String @unique
  passwordHash String
  mascotas     Mascota[]
}

model Mascota {
  id        String @id @default(uuid()) @db.Uuid
  nombre    String
  usuarioId String @db.Uuid
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  viajes    Viaje[]
  documentos Documento[]

  @@index([usuarioId])
}

model Viaje {
  id          String @id @default(uuid()) @db.Uuid
  origen      String
  destino     String
  fechaSalida DateTime @db.Date
  mascotaId   String @db.Uuid
  mascota     Mascota @relation(fields: [mascotaId], references: [id], onDelete: Restrict)
  tareas      Tarea[]

  @@index([mascotaId])
}

enum EstadoTarea {
  pendiente
  completa
  requiere_revision
}

model Tarea {
  id          String @id @default(uuid()) @db.Uuid
  descripcion String
  estado      EstadoTarea @default(pendiente)
  viajeId     String @db.Uuid
  viaje       Viaje @relation(fields: [viajeId], references: [id], onDelete: Restrict)
  documentos DocumentoTarea[]

  @@index([viajeId])
}

enum TipoVigencia {
  fecha
  sin_vencimiento
  desconocida
}

model Documento {
  id               String @id @default(uuid()) @db.Uuid
  identificacion   String
  vigencia         TipoVigencia
  fechaVencimiento DateTime? @db.Date
  mascotaId        String @db.Uuid
  mascota          Mascota @relation(fields: [mascotaId], references: [id], onDelete: Restrict)
  tareas           DocumentoTarea[]

  @@index([mascotaId])
}

model DocumentoTarea {
  documentoId String @db.Uuid
  tareaId     String @db.Uuid
  documento   Documento @relation(fields: [documentoId], references: [id], onDelete: Restrict)
  tarea       Tarea @relation(fields: [tareaId], references: [id], onDelete: Restrict)

  @@id([documentoId, tareaId])
  @@index([tareaId])
}
